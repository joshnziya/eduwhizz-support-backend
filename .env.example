# Copy this file to .env and fill in real values before running in production.

# Port the API server listens on
PORT=4000

# Secret used to sign login tokens (JWT). Use a long random string in production.
JWT_SECRET=change-this-to-a-long-random-string

# Comma-separated list of origins allowed to call this API from a browser.
# Set this to the URL(s) where the EduWhizz frontend is hosted.
CORS_ORIGIN=*

# Default password assigned to seeded staff accounts (change immediately after first login)
SEED_DEFAULT_PASSWORD=changeme123

# --- Email (SMTP) settings, used ONLY for "new ticket" notifications ---
# These do NOT affect login in any way. If left blank, notifications are printed to the
# server console/logs instead of emailed. Give each staff account an email via the admin
# panel (optional field) to have them notified when a new ticket comes in.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
