# Copy this file to .env and fill in real values before running in production.

# Port the API server listens on
PORT=4000

# Secret used to sign login tokens (JWT). Use a long random string in production.
JWT_SECRET=change-this-to-a-long-random-string

# Comma-separated list of origins allowed to call this API from a browser.
# Set this to the URL(s) where the EduWhizz frontend is hosted.
CORS_ORIGIN=*

# Default password assigned to seeded staff accounts (change immediately after first login)
SEED_DEFAULT_PASSWORD=changeme123

# Real email for the seeded admin account, so admin sign-in codes go somewhere you can read.
# If you skip this, the admin account gets a placeholder email and codes will only appear
# in the server logs (see SMTP section below) until you set a real one via the admin panel.
SEED_ADMIN_EMAIL=

# --- Email (SMTP) settings, used to send admin sign-in codes ---
# If these are left blank, sign-in codes are printed to the server console/logs instead of
# emailed \u2014 the app still works, you just have to check logs to find the code.
# Any standard SMTP provider works: Gmail (with an App Password), Resend, SendGrid, Mailgun, etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

